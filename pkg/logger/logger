package logger

import (
	"fmt"
	"io"
	"log"
	"os"
	"strings"
)

// Level type for logging levels
type Level string

const (
	LevelDebug Level = "debug"
	LevelInfo  Level = "info"
	LevelWarn  Level = "warn"
	LevelError Level = "error"
)

// Logger interface
type Logger interface {
	Debug(msg string, fields ...interface{})
	Info(msg string, fields ...interface{})
	Warn(msg string, fields ...interface{})
	Error(msg string, fields ...interface{})
	SetLevel(level Level)
}

// defaultLogger implements Logger interface
type defaultLogger struct {
	level   Level
	stdlog  *log.Logger
	logFile *os.File
}

var (
	instance   *defaultLogger
	levelOrder = map[Level]int{
		LevelDebug: 0,
		LevelInfo:  1,
		LevelWarn:  2,
		LevelError: 3,
	}
)

// Setup configures the logger with the specified level
func Setup(level Level) error {
	var logFile *os.File
	var err error

	// Open log file for appending
	logFile, err = os.OpenFile("wol-proxy.log",
		os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0666)
	if err != nil {
		return fmt.Errorf("failed to open log file: %v", err)
	}

	// Create logger that writes to both console and file
	multiWriter := NewMultiWriter(os.Stdout, logFile)
	logger := &defaultLogger{
		level:   level,
		stdlog:  log.New(multiWriter, "", log.Ldate|log.Ltime|log.Lmicroseconds),
		logFile: logFile,
	}

	instance = logger
	return nil
}

// MultiWriter writes to multiple writers
type MultiWriter struct {
	writers []io.Writer
}

// NewMultiWriter creates a new multi-writer
func NewMultiWriter(writers ...io.Writer) *MultiWriter {
	return &MultiWriter{writers: writers}
}

// Write writes to all writers
func (mw *MultiWriter) Write(p []byte) (n int, err error) {
	for _, w := range mw.writers {
		n, err = w.Write(p)
		if err != nil {
			return n, err
		}
	}
	return len(p), nil
}

// shouldLog checks if message at this level should be logged
func (l *defaultLogger) shouldLog(msgLevel Level) bool {
	return levelOrder[msgLevel] >= levelOrder[l.level]
}

// format formats the log message with fields
func (l *defaultLogger) format(msg string, fields ...interface{}) string {
	if len(fields) == 0 {
		return msg
	}

	var pairs []string
	for i := 0; i < len(fields); i += 2 {
		if i+1 < len(fields) {
			key := fmt.Sprintf("%v", fields[i])
			value := fmt.Sprintf("%v", fields[i+1])
			pairs = append(pairs, fmt.Sprintf("%s=%s", key, value))
		}
	}

	if len(pairs) > 0 {
		return fmt.Sprintf("%s %s", msg, strings.Join(pairs, " "))
	}

	return msg
}

// Debug logs debug messages
func Debug(msg string, fields ...interface{}) {
	if instance == nil {
		Setup(LevelInfo)
	}
	if instance.shouldLog(LevelDebug) {
		instance.stdlog.Printf("[DEBUG] %s", instance.format(msg, fields...))
	}
}

func (l *defaultLogger) Debug(msg string, fields ...interface{}) {
	if l.shouldLog(LevelDebug) {
		l.stdlog.Printf("[DEBUG] %s", l.format(msg, fields...))
	}
}

